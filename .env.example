# Copiar a .env.local para desarrollo. En producción estos valores van en el entorno del compose (Fase 20).

# Conexión de la app: rol de mínimo privilegio sgc_app (lo crea db:roles / el arranque).
DATABASE_URL=postgres://sgc_app:sgc_app_dev@localhost:5435/sgc
# Conexión del dueño del esquema: migraciones, semillas y creación del rol de la app.
# Si falta, modo heredado: todo corre con DATABASE_URL.
DATABASE_URL_MIGRADOR=postgres://sgc:sgc_dev@localhost:5435/sgc
# Clave del rol sgc_app; se sincroniza en cada arranque. Debe coincidir con la de DATABASE_URL
# y con la de docker-compose.dev.yml (misma base de 5435).
BD_APP_CLAVE=sgc_app_dev
# 32 bytes en base64 (cifra los secretos TOTP en reposo). Obligatoria en producción.
# Generar con: openssl rand -base64 32   (el valor de abajo es solo de desarrollo)
APP_SECRETO=EydHcw1DuRRigzlQG5UXcwVA+SHK+ScJTToKXv6qQic=

# Proxy delante de la app (Caddy, Fase 20): 1 = la IP sale de X-Forwarded-For/X-Real-IP; vacío = IP desconocida.
CONFIAR_PROXY=
# Zona horaria de la instalación (nombre IANA): fechas de corte, filtros y horas mostradas.
ZONA_HORARIA=America/Bogota
# Solo desarrollo: otros equipos de la red (un celular) que abren `npm run dev`. Nombres de host o IP, sin esquema
# ni puerto, separados por coma. Sin esto, desde otro equipo la página carga pero nada interactivo funciona.
DEV_ORIGENES=
# Minutos de inactividad antes de cerrar la sesión.
SESION_INACTIVIDAD_MIN=60
# Roles con TOTP obligatorio, separados por coma (p. ej. admin_sgc,gerencia). Vacío = opcional.
EXIGIR_2FA_ROLES=

# Primer Admin SGC (bootstrap; npm run admin:asegurar o el arranque del contenedor).
# Retirar ADMIN_CLAVE tras el primer arranque. Rescate: ADMIN_FORZAR_CLAVE=1 en el contenedor
# o npm run admin:asegurar -- --forzar-clave en desarrollo.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador del SGC
ADMIN_CLAVE=cambiar-esta-clave
