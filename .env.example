# Copiar a .env.local para desarrollo. En el NAS estos valores van en el compose.

# Conexión de la app: rol de mínimo privilegio sgc_app (lo crea db:roles / el arranque).
DATABASE_URL=postgres://sgc_app:sgc_app_dev@localhost:5435/sgc
# Conexión del dueño del esquema: migraciones, semillas y creación del rol de la app.
# Si falta, modo heredado: todo corre con DATABASE_URL.
DATABASE_URL_MIGRADOR=postgres://sgc:sgc_dev@localhost:5435/sgc
# Clave del rol sgc_app; se sincroniza en cada arranque. Debe coincidir con la de DATABASE_URL
# y con la de docker-compose.dev.yml (misma base de 5435).
BD_APP_CLAVE=sgc_app_dev
# 32 bytes en base64 (cifra los secretos TOTP en reposo). Obligatoria en producción.
# Generar con: openssl rand -base64 32   (el valor de abajo es solo de desarrollo)
APP_SECRETO=EydHcw1DuRRigzlQG5UXcwVA+SHK+ScJTToKXv6qQic=

# Cuenta del administrador (bootstrap). Retirar ADMIN_CLAVE tras el primer arranque.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador del SGC
ADMIN_CLAVE=cambiar-esta-clave
