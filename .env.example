# Copiar a .env.local para desarrollo. En el NAS estos valores van en el compose.
DATABASE_URL=postgres://sgc:sgc_dev@localhost:5434/sgc

# Cuenta del administrador (bootstrap). Retirar ADMIN_CLAVE tras el primer arranque.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador del SGC
ADMIN_CLAVE=cambiar-esta-clave
